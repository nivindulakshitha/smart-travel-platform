		{
			"name": "Booking Service (Port 8084) - MAIN ORCHESTRATOR",
			"description": "Main orchestrator service that coordinates all microservices",
			"item": [
				{
					"name": "Create Booking",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Booking created with CONFIRMED status', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('bookingId');",
									"    pm.expect(jsonData.status).to.equal('CONFIRMED');",
									"    pm.expect(jsonData).to.have.property('totalCost');",
									"});",
									"",
									"// Save bookingId for subsequent requests",
									"var jsonData = pm.response.json();",
									"pm.environment.set('bookingId', jsonData.bookingId);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userId\": 1,\n  \"flightId\": 1,\n  \"hotelId\": 1,\n  \"travelDate\": \"2025-12-25\"\n}"
						},
						"url": {
							"raw": "http://localhost:8084/bookings",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8084",
							"path": ["bookings"]
						},
						"description": "Create a new booking. This triggers the complete orchestration workflow:\n1. Validate user (User Service)\n2. Check flight availability (Flight Service)\n3. Check hotel availability (Hotel Service)\n4. Calculate total cost\n5. Create booking with PENDING status\n6. Process payment (Payment Service)\n7. Send notification (Notification Service)\n8. Update booking to CONFIRMED\n\nExpected total cost: Flight price + Hotel price (for 1 night)"
					},
					"response": [
						{
							"name": "Success Response",
							"originalRequest": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"userId\": 1,\n  \"flightId\": 1,\n  \"hotelId\": 1,\n  \"travelDate\": \"2025-12-25\"\n}"
								},
								"url": {
									"raw": "http://localhost:8084/bookings",
									"protocol": "http",
									"host": ["localhost"],
									"port": "8084",
									"path": ["bookings"]
								}
							},
							"status": "OK",
							"code": 200,
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n  \"bookingId\": 1,\n  \"userId\": 1,\n  \"flightId\": 1,\n  \"hotelId\": 1,\n  \"travelDate\": \"2025-12-25\",\n  \"totalCost\": 449.99,\n  \"status\": \"CONFIRMED\"\n}"
						}
					]
				},
